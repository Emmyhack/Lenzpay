{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Needed for the node:test-based engine suite in services/**/*.test.ts.
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
