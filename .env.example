# =============================================================================
# LenzPay environment inventory
# =============================================================================
# Copy this file to `.env.local` for local Expo development.
#
# SECURITY RULE:
# Only EXPO_PUBLIC_* values are bundled into the mobile/web application and
# are visible to every user. Never prefix API keys, webhook secrets, signing
# keys, database URLs, or provider credentials with EXPO_PUBLIC_.
#
# Sections below marked BACKEND-ONLY belong in the future LenzPay API/worker
# deployment (EAS environment variables, a cloud secret manager, etc.), not in
# the Expo app. They are listed here so this file doubles as the service map.

# -----------------------------------------------------------------------------
# EXPO APP — safe to expose to clients
# -----------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# true: current working demo with local mock balances, rails, KYC, and history.
# false: services/* call EXPO_PUBLIC_API_BASE_URL; use only when that API exists.
EXPO_PUBLIC_USE_MOCK_DATA=true

# Optional client telemetry. A DSN is an ingestion endpoint, not a secret.
EXPO_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# CORE API & DATA — BACKEND-ONLY
# Services: authentication, users, payees, sources, payments, merchant API,
# ledger persistence, disputes, reconciliation, and idempotency.
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
APP_DEEP_LINK_SCHEME=lenzpay
DATABASE_URL=postgresql://user:password@localhost:5432/lenzpay
REDIS_URL=redis://localhost:6379

# Generate strong independent values; do not reuse them between environments.
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
FIELD_ENCRYPTION_KEY=replace_me_32_byte_key
IDEMPOTENCY_HMAC_SECRET=replace_me
WEBHOOK_PUBLIC_BASE_URL=https://api.example.com/webhooks

# -----------------------------------------------------------------------------
# AUTHENTICATION & COMMUNICATIONS — BACKEND-ONLY
# Needed for phone/email signup, OTP delivery, receipts, and security alerts.
# Candidate vendors are intentionally not forced by the app architecture.
# -----------------------------------------------------------------------------
SMS_PROVIDER=termii
SMS_API_BASE_URL=
SMS_API_KEY=
SMS_SENDER_ID=LenzPay
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="LenzPay <no-reply@example.com>"

# -----------------------------------------------------------------------------
# KYC / IDENTITY — BACKEND-ONLY
# Services required by services/kyc.ts: BVN/NIN verification, ID document
# checks, selfie/liveness, sanctions/PEP screening, and status webhooks.
# Examples to evaluate: Smile ID, Dojah, Prembly, Youverify.
# -----------------------------------------------------------------------------
KYC_PROVIDER=
KYC_API_BASE_URL=
KYC_API_KEY=
KYC_PARTNER_ID=
KYC_WEBHOOK_SECRET=
KYC_BVN_PRODUCT_CODE=
KYC_NIN_PRODUCT_CODE=

# Private KYC images should be uploaded with backend-issued signed URLs.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=lenzpay-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# -----------------------------------------------------------------------------
# BANK AGGREGATION — BACKEND-ONLY
# Required capabilities: consent/account linking, live balance reads, mandates,
# debit initiation, debit status, revocation, and signed webhooks.
# Architecture requires a primary plus a fallback (e.g. evaluate Mono/Okra);
# final vendors depend on commercial terms and bank-by-bank reachability.
# -----------------------------------------------------------------------------
BANK_AGGREGATOR_PRIMARY=
BANK_AGGREGATOR_PRIMARY_BASE_URL=
BANK_AGGREGATOR_PRIMARY_CLIENT_ID=
BANK_AGGREGATOR_PRIMARY_SECRET=
BANK_AGGREGATOR_PRIMARY_WEBHOOK_SECRET=
BANK_AGGREGATOR_PRIMARY_LIVE=false

BANK_AGGREGATOR_SECONDARY=
BANK_AGGREGATOR_SECONDARY_BASE_URL=
BANK_AGGREGATOR_SECONDARY_CLIENT_ID=
BANK_AGGREGATOR_SECONDARY_SECRET=
BANK_AGGREGATOR_SECONDARY_WEBHOOK_SECRET=
BANK_AGGREGATOR_SECONDARY_LIVE=false

# -----------------------------------------------------------------------------
# PSP / PAYOUT / FLOAT — BACKEND-ONLY
# Pays merchants and owns/operates the launch float. This must be a licensed
# partner. Direct NIBSS credentials are intentionally not assumed for MVP.
# -----------------------------------------------------------------------------
PSP_PROVIDER=
PSP_API_BASE_URL=
PSP_API_KEY=
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRET=
PSP_SETTLEMENT_ACCOUNT_ID=
PSP_FLOAT_ACCOUNT_ID=

# Regulatory mode must be enforced by the backend, never trusted from a client.
# partner_tsp | partner_float | own_licence
LENZPAY_LAUNCH_PHASE=partner_float
TREASURY_PER_TRANSACTION_NGN=200000
TREASURY_PER_USER_OUTSTANDING_NGN=500000
TREASURY_GLOBAL_OUTSTANDING_NGN=50000000

# -----------------------------------------------------------------------------
# FX / DOMICILIARY ACCOUNTS — BACKEND-ONLY
# Needs balance access, firm executable quotes locked for at least 45 seconds,
# conversion settlement, reversals, payout status, and signed webhooks.
# -----------------------------------------------------------------------------
FX_PROVIDER=
FX_API_BASE_URL=
FX_API_KEY=
FX_API_SECRET=
FX_WEBHOOK_SECRET=
FX_RATE_LOCK_SECONDS=45
FX_MAX_SILENT_DRIFT=0.005

# Optional independent reference-rate feed used for monitoring/best execution.
MARKET_DATA_PROVIDER=
MARKET_DATA_API_BASE_URL=
MARKET_DATA_API_KEY=

# -----------------------------------------------------------------------------
# CRYPTO CUSTODY / LIQUIDITY / OFF-RAMP — BACKEND-ONLY
# The planned model is a licensed VASP custody partner, not keys in the app.
# Needs address/account creation, balances, debit authority, firm swap quotes,
# conversion, fiat off-ramp, refunds, travel-rule/compliance, and webhooks.
# -----------------------------------------------------------------------------
CRYPTO_CUSTODY_PROVIDER=
CRYPTO_CUSTODY_API_BASE_URL=
CRYPTO_CUSTODY_API_KEY=
CRYPTO_CUSTODY_API_SECRET=
CRYPTO_CUSTODY_WEBHOOK_SECRET=
CRYPTO_OFFRAMP_ACCOUNT_ID=
CRYPTO_SUPPORTED_ASSETS=BTC,ETH,USDT,USDC,SOL

# Exchange or wallet credentials entered by a user must be posted to the API,
# encrypted with FIELD_ENCRYPTION_KEY, and tokenized. Never store them in Expo
# state, AsyncStorage, source control, logs, or EXPO_PUBLIC_* variables.

# -----------------------------------------------------------------------------
# FRAUD, DEVICE RISK & COMPLIANCE — BACKEND-ONLY
# The app currently has deterministic pre-payment guardrails; production also
# needs authoritative server-side velocity, device, sanctions, and AML checks.
# -----------------------------------------------------------------------------
FRAUD_PROVIDER=
FRAUD_API_BASE_URL=
FRAUD_API_KEY=
DEVICE_RISK_PROVIDER=
DEVICE_RISK_API_KEY=
AML_SCREENING_PROVIDER=
AML_SCREENING_API_KEY=

# -----------------------------------------------------------------------------
# PUSH NOTIFICATIONS — BACKEND-ONLY
# Expo push tokens are collected by the app; sending credentials stay server-side.
# -----------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=
PUSH_RECEIPT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# OBSERVABILITY & OPERATIONS — BACKEND-ONLY
# Audit logs must redact BVN/NIN, tokens, bank details, wallet keys, and PII.
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LOG_LEVEL=info

# Reconciliation/collection workers and operational alerts.
COLLECTION_SWEEP_CRON=0 2 * * *
RECONCILIATION_SWEEP_CRON=*/15 * * * *
OPS_ALERT_WEBHOOK_URL=
